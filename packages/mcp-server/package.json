{
  "name": "@stareezy-ui/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Stareezy UI — query tokens, components, themes, and scaffold code through a standard tool interface",
  "main": "dist/index.js",
  "bin": {
    "stareezy-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "dev": "tsup src/index.ts --format cjs --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@stareezy-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "mcp",
    "stareezy-ui",
    "design-tokens",
    "ai",
    "model-context-protocol"
  ],
  "license": "MIT"
}
