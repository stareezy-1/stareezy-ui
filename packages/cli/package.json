{
  "name": "@stareezy-ui/cli",
  "version": "0.1.0",
  "description": "Stareezy UI CLI — scaffold projects and add components",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "stareezy": "./dist/index.js",
    "create-stareezy": "./dist/create.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "stareezy-ui",
    "cli",
    "scaffolding",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stareezy-1/stareezy-ui.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
