{
  "name": "@stareezy-ui/components",
  "version": "0.3.0",
  "description": "Stareezy UI component library — 17+ cross-platform React Native and web components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "stareezy-ui",
    "components",
    "react-native",
    "web",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stareezy-1/stareezy-ui.git",
    "directory": "packages/components"
  },
  "scripts": {
    "build": "tsup && node scripts/check-server-purity.mjs && node scripts/check-no-hardcoded-colors.mjs",
    "build:cdn": "tsup --config tsup.cdn.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run build:cdn && pnpm run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stareezy-ui/tokens": "workspace:*",
    "@stareezy-ui/core": "workspace:*",
    "@stareezy-ui/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-native": ">=0.81 <0.87",
    "@react-native-community/slider": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@react-native-community/slider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "fast-check": "^3.19.0",
    "@testing-library/react": "^15.0.0",
    "react": "^18.3.0"
  }
}
