{
  "name": "@stareezy-ui/components",
  "version": "0.1.1",
  "description": "Stareezy UI component library — 70+ cross-platform React Native and web components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "stareezy-ui",
    "components",
    "react-native",
    "web",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stareezy-1/stareezy-ui.git",
    "directory": "packages/components"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stareezy-ui/tokens": "workspace:*",
    "@stareezy-ui/core": "workspace:*",
    "@stareezy-ui/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "fast-check": "^3.19.0",
    "@testing-library/react": "^15.0.0",
    "react": "^18.3.0"
  }
}
