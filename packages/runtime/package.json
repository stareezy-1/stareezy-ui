{
  "name": "@stareezy-ui/runtime",
  "version": "0.2.3",
  "description": "Stareezy UI runtime — O(1) token-to-style lookup and platform adapters",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "stareezy-ui",
    "runtime",
    "style-registry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stareezy-1/stareezy-ui.git",
    "directory": "packages/runtime"
  },
  "scripts": {
    "build": "tsup",
    "build:cdn": "tsup --config tsup.cdn.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run build:cdn && pnpm run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stareezy-ui/tokens": "workspace:*",
    "@stareezy-ui/stylesheet": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "fast-check": "^3.19.0"
  }
}
