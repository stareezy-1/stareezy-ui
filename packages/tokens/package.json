{
  "name": "@stareezy-ui/tokens",
  "version": "0.0.1",
  "description": "Stareezy UI design token definitions — zero dependencies",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "tokens",
    "stareezy-ui",
    "react-native",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stareezy-ui/stareezy-ui.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "fast-check": "^3.23.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
