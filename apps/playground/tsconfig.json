{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@stareezy-ui/tokens": ["../../packages/tokens/src/index.ts"],
      "@stareezy-ui/tokens/*": ["../../packages/tokens/src/*"],
      "@stareezy-ui/components": ["../../packages/components/src/index.ts"],
      "@stareezy-ui/components/*": ["../../packages/components/src/*"],
      "@stareezy-ui/runtime": ["../../packages/runtime/src/index.ts"],
      "@stareezy-ui/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
