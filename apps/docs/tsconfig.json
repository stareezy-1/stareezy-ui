{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@quasify-ui/tokens": ["../../packages/tokens/src/index.ts"],
      "@quasify-ui/tokens/*": ["../../packages/tokens/src/*"],
      "@quasify-ui/core": ["../../packages/core/src/index.ts"],
      "@quasify-ui/core/*": ["../../packages/core/src/*"],
      "@quasify-ui/runtime": ["../../packages/runtime/src/index.ts"],
      "@quasify-ui/runtime/*": ["../../packages/runtime/src/*"],
      "@quasify-ui/compiler": ["../../packages/compiler/src/index.ts"],
      "@quasify-ui/compiler/*": ["../../packages/compiler/src/*"],
      "@quasify-ui/stylesheet": ["../../packages/stylesheet/src/index.ts"],
      "@quasify-ui/stylesheet/*": ["../../packages/stylesheet/src/*"],
      "@quasify-ui/components": ["../../packages/components/src/index.ts"],
      "@quasify-ui/components/*": ["../../packages/components/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts",
    "../../packages/tokens/src/**/*.ts",
    "../../packages/tokens/src/**/*.tsx",
    "../../packages/runtime/src/**/*.ts",
    "../../packages/core/src/**/*.ts"
  ],
  "exclude": ["node_modules", "../../packages/*/node_modules"]
}
